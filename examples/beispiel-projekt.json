{
  "schema_version": "1.0",
  "mode": "v_cutting",
  "project": {
    "name": "Beispiel V-Cutting"
  },
  "plate": {
    "width_mm": 400,
    "height_mm": 400,
    "thickness_mm": 3,
    "top_z_mm": 0,
    "margin_mm": 20
  },
  "tool": {
    "id": "T246",
    "name": "V-Nutfraeser",
    "type": "v_bit",
    "angle_deg": 90
  },
  "carving": {
    "max_depth_mm": 1.2,
    "line_spacing_mm": 2.5,
    "orientation": "vertical",
    "path_mode": "serpentine",
    "clearance_z_mm": 1,
    "motif_margin_mm": 5,
    "tone_threshold": 0.055,
    "depth_gamma": 1.0
  },
  "cleanup": {
    "remove_speckles": true,
    "keep_largest_component": true,
    "smooth_raster_edges": true,
    "transparent_background": true,
    "background_threshold": 0.95,
    "min_component_area_ratio": 0.0005
  },
  "simplification": {
    "mode": "catia_strong",
    "sample_distance_mm": 2,
    "smoothing_distance_mm": 2,
    "rdp_tolerance_mm": 0.18,
    "target_reduction_percent": 90
  },
  "relief": {
    "height_mm": 2,
    "invert": false,
    "smoothing_mm": 0.5,
    "base_thickness_mm": 1,
    "sample_distance_mm": 0.5
  },
  "output": {
    "include_reference_plate": true,
    "step": true,
    "stl": false,
    "preview_png": true
  }
}
